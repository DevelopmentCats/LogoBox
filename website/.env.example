# LogoBox Website Environment Configuration Template
# Copy this file to .env.development or .env.production and fill in appropriate values
# This file contains Vite-specific environment variables for the website

# =============================================================================
# APPLICATION BRANDING
# =============================================================================

# Application title shown in browser tab and meta tags
VITE_APP_TITLE=LogoBox

# Application description for meta tags and SEO
VITE_APP_DESCRIPTION=Browse and discover high-quality logos and icons

# =============================================================================
# API AND CDN ENDPOINTS
# =============================================================================

# Base URL for API requests
# Development: http://localhost:3001
# Production: https://api.logobox.dev
VITE_API_BASE_URL=https://api.logobox.dev

# CDN base URL for serving static assets and logos
# Development: http://localhost:3000/assets
# Production: https://cdn.logobox.dev
VITE_CDN_BASE_URL=https://cdn.logobox.dev

# Path to the catalog JSON file (relative to CDN base URL)
VITE_CATALOG_PATH=/catalog.json

# Path to the logos directory (relative to CDN base URL)
VITE_LOGOS_PATH=/logos

# =============================================================================
# API CLIENT SETTINGS
# =============================================================================

# Request timeout in milliseconds
# Development: 5000 (5 seconds for faster feedback)
# Production: 15000 (15 seconds for reliability)
VITE_API_TIMEOUT=15000

# Number of retry attempts for failed requests
# Development: 2 (fewer retries for faster development)
# Production: 3 (more retries for reliability)
VITE_API_RETRY_ATTEMPTS=3

# Delay between retry attempts in milliseconds
# Development: 500 (shorter delay for faster development)
# Production: 2000 (longer delay to avoid overwhelming servers)
VITE_API_RETRY_DELAY=2000

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable analytics tracking
# Development: false (no tracking during development)
# Production: true (enable tracking in production)
VITE_ENABLE_ANALYTICS=true

# Enable performance monitoring
# Development: true (useful for debugging performance issues)
# Production: false (reduce overhead in production)
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Logging level (debug, info, warn, error)
# Development: debug (verbose logging for development)
# Production: warn (minimal logging for production)
VITE_LOG_LEVEL=warn

# =============================================================================
# HIGH AVAILABILITY (OPTIONAL)
# =============================================================================

# Fallback CDN URLs for redundancy
# Leave empty if not using fallback CDNs
VITE_CDN_FALLBACK_URL_1=
VITE_CDN_FALLBACK_URL_2=

# =============================================================================
# DEVELOPMENT ENVIRONMENT EXAMPLE
# =============================================================================
# For development, create .env.development with these values:
#
# VITE_APP_TITLE=LogoBox (Dev)
# VITE_APP_DESCRIPTION=Browse and discover high-quality logos and icons - Development
# VITE_API_BASE_URL=http://localhost:3001
# VITE_CDN_BASE_URL=http://localhost:3000/assets
# VITE_CATALOG_PATH=/catalog.json
# VITE_LOGOS_PATH=/logos
# VITE_API_TIMEOUT=5000
# VITE_API_RETRY_ATTEMPTS=2
# VITE_API_RETRY_DELAY=500
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_PERFORMANCE_MONITORING=true
# VITE_LOG_LEVEL=debug

# =============================================================================
# PRODUCTION ENVIRONMENT EXAMPLE
# =============================================================================
# For production, create .env.production with these values:
#
# VITE_APP_TITLE=LogoBox
# VITE_APP_DESCRIPTION=Browse and discover high-quality logos and icons
# VITE_API_BASE_URL=https://api.logobox.dev
# VITE_CDN_BASE_URL=https://cdn.logobox.dev
# VITE_CATALOG_PATH=/catalog.json
# VITE_LOGOS_PATH=/logos
# VITE_API_TIMEOUT=15000
# VITE_API_RETRY_ATTEMPTS=3
# VITE_API_RETRY_DELAY=2000
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_PERFORMANCE_MONITORING=false
# VITE_LOG_LEVEL=warn