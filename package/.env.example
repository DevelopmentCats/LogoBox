# LogoBox NPM Package Environment Configuration Template
# Copy this file to .env and fill in appropriate values for package development and testing
# These variables are used by the LogoBox NPM package

# =============================================================================
# LOGOBOX PACKAGE CONFIGURATION
# =============================================================================

# Base URL for LogoBox website and API
# Used for package documentation and API calls
# Development: http://localhost:3000
# Production: https://logobox.dev
LOGOBOX_BASE_URL=https://logobox.dev

# CDN Base URL for logo asset retrieval
# Used by the package to fetch logo files
# Development: http://localhost:3000/assets
# Production: https://cdn.logobox.dev
LOGOBOX_CDN_BASE_URL=https://cdn.logobox.dev

# Default logo variant to use when none is specified
# Options: original, optimized, black, white
LOGOBOX_DEFAULT_VARIANT=original

# Enable caching for logo retrieval (true/false)
# Improves performance by caching frequently accessed logos
LOGOBOX_CACHE_ENABLED=true

# Cache Time To Live in milliseconds
# How long to cache logos before refetching
# Default: 3600000 (1 hour)
LOGOBOX_CACHE_TTL=3600000

# API Base URL for dynamic logo generation features
# Used for advanced package features like custom logo generation
# Development: http://localhost:3001
# Production: https://api.logobox.dev
LOGOBOX_API_BASE_URL=https://api.logobox.dev

# =============================================================================
# DEVELOPMENT AND TESTING
# =============================================================================

# Node.js environment (development, test, production)
# Affects logging, error handling, and performance optimizations
NODE_ENV=development

# Enable debug logging for package development (true/false)
# Shows detailed logs for troubleshooting
DEBUG=false

# Test timeout in milliseconds for package tests
# Increase if tests are timing out
TEST_TIMEOUT=10000

# =============================================================================
# NPM PUBLISHING (GitHub Secrets - DO NOT SET IN .env)
# =============================================================================
# These should be set as GitHub Secrets for automated publishing

# NPM authentication token for publishing
# Set as GitHub Secret: NPM_TOKEN or NODE_AUTH_TOKEN
# NPM_TOKEN=your_npm_token_here
# NODE_AUTH_TOKEN=your_npm_token_here

# GitHub token for repository access
# Set as GitHub Secret: GITHUB_TOKEN (automatically provided)
# GITHUB_TOKEN=your_github_token_here

# =============================================================================
# CI/CD ENVIRONMENT VARIABLES
# =============================================================================
# These are typically set by the CI/CD environment

# Indicates if running in CI environment (true/false)
# CI=false

# Git commit SHA (set by GitHub Actions)
# GITHUB_SHA=commit_sha_here

# Git branch name (set by GitHub Actions)
# GITHUB_REF_NAME=branch_name_here

# =============================================================================
# DEVELOPMENT ENVIRONMENT EXAMPLE
# =============================================================================
# For local development, create .env with these values:
#
# LOGOBOX_BASE_URL=http://localhost:3000
# LOGOBOX_CDN_BASE_URL=http://localhost:3000/assets
# LOGOBOX_API_BASE_URL=http://localhost:3001
# LOGOBOX_DEFAULT_VARIANT=original
# LOGOBOX_CACHE_ENABLED=true
# LOGOBOX_CACHE_TTL=3600000
# NODE_ENV=development
# DEBUG=true
# TEST_TIMEOUT=10000

# =============================================================================
# PRODUCTION ENVIRONMENT EXAMPLE
# =============================================================================
# For production testing, create .env with these values:
#
# LOGOBOX_BASE_URL=https://logobox.dev
# LOGOBOX_CDN_BASE_URL=https://cdn.logobox.dev
# LOGOBOX_API_BASE_URL=https://api.logobox.dev
# LOGOBOX_DEFAULT_VARIANT=original
# LOGOBOX_CACHE_ENABLED=true
# LOGOBOX_CACHE_TTL=3600000
# NODE_ENV=production
# DEBUG=false
# TEST_TIMEOUT=15000