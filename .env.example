
# LogoBox Environment Configuration Template
# Copy this file to .env and fill in the appropriate values for your environment
# DO NOT commit .env files to version control - they contain sensitive information

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application Title and Description
# Used in website meta tags, page titles, and branding
VITE_APP_TITLE=LogoBox
VITE_APP_DESCRIPTION=Browse and discover high-quality logos and icons

# =============================================================================
# API AND CDN CONFIGURATION
# =============================================================================

# Base URL for the LogoBox API
# Development: http://localhost:3001
# Production: https://api.logobox.dev
VITE_API_BASE_URL=https://api.logobox.dev

# CDN Base URL for serving logo assets
# Development: http://localhost:3000/assets
# Production: https://cdn.logobox.dev
VITE_CDN_BASE_URL=https://cdn.logobox.dev

# Path to the logo catalog JSON file (relative to CDN base URL)
VITE_CATALOG_PATH=/catalog.json

# Path to the logos directory (relative to CDN base URL)
VITE_LOGOS_PATH=/logos

# Fallback CDN URLs for high availability (optional)
# These are used if the primary CDN is unavailable
VITE_CDN_FALLBACK_URL_1=https://backup-cdn1.logobox.dev
VITE_CDN_FALLBACK_URL_2=https://backup-cdn2.logobox.dev

# =============================================================================
# API CLIENT CONFIGURATION
# =============================================================================

# API request timeout in milliseconds
# Development: 5000 (5 seconds)
# Production: 15000 (15 seconds)
VITE_API_TIMEOUT=15000

# Number of retry attempts for failed API requests
# Development: 2
# Production: 3
VITE_API_RETRY_ATTEMPTS=3

# Delay between retry attempts in milliseconds
# Development: 500
# Production: 2000
VITE_API_RETRY_DELAY=2000

# =============================================================================
# APPLICATION FEATURES
# =============================================================================

# Enable analytics tracking (true/false)
# Development: false
# Production: true
VITE_ENABLE_ANALYTICS=true

# Enable performance monitoring (true/false)
# Development: true (for debugging)
# Production: false (to reduce overhead)
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Logging level (debug, info, warn, error)
# Development: debug
# Production: warn
VITE_LOG_LEVEL=warn

# =============================================================================
# NPM PACKAGE CONFIGURATION
# =============================================================================

# Base URL for LogoBox package API calls
# Used by the NPM package for programmatic access
LOGOBOX_BASE_URL=https://logobox.dev

# CDN Base URL for LogoBox package
# Used by the NPM package for asset retrieval
LOGOBOX_CDN_BASE_URL=https://cdn.logobox.dev

# Default logo variant for package usage (original, optimized, black, white)
LOGOBOX_DEFAULT_VARIANT=original

# Enable caching in the LogoBox package (true/false)
LOGOBOX_CACHE_ENABLED=true

# Cache TTL (Time To Live) in milliseconds for package cache
# Default: 3600000 (1 hour)
LOGOBOX_CACHE_TTL=3600000

# LogoBox API base URL for dynamic generation features
LOGOBOX_API_BASE_URL=https://api.logobox.dev

# =============================================================================
# DEPLOYMENT CONFIGURATION (GitHub Secrets - DO NOT SET IN .env)
# =============================================================================
# These variables should be set as GitHub Secrets, not in .env files
# They are listed here for documentation purposes only

# NPM authentication token for package publishing
# Set as GitHub Secret: NPM_TOKEN
# NPM_TOKEN=your_npm_token_here

# GitHub token for repository access and releases
# Set as GitHub Secret: GITHUB_TOKEN (automatically provided by GitHub Actions)
# GITHUB_TOKEN=your_github_token_here

# Cloudflare API token for Pages deployment
# Set as GitHub Secret: CLOUDFLARE_API_TOKEN
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Cloudflare Account ID for Pages deployment
# Set as GitHub Secret: CLOUDFLARE_ACCOUNT_ID
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# =============================================================================
# LEGACY DEPLOYMENT VARIABLES (AWS - if still needed)
# =============================================================================
# These are used by legacy deployment scripts and may be removed in future versions

# S3 bucket for website deployment (legacy)
# WEBSITE_BUCKET=your-s3-bucket-name

# CloudFront distribution ID for website (legacy)
# WEBSITE_DISTRIBUTION_ID=your-cloudfront-distribution-id

# CDN bucket for asset storage (legacy)
# CDN_BUCKET=your-cdn-bucket-name

# CloudFront distribution ID for CDN (legacy)
# CLOUDFRONT_DISTRIBUTION_ID=your-cdn-distribution-id

# Staging environment variables (legacy)
# STAGING_WEBSITE_BUCKET=your-staging-bucket
# STAGING_DISTRIBUTION_ID=your-staging-distribution-id

# Production environment variables (legacy)
# PRODUCTION_WEBSITE_BUCKET=your-production-bucket
# PRODUCTION_DISTRIBUTION_ID=your-production-distribution-id

# =============================================================================
# DEVELOPMENT ENVIRONMENT OVERRIDES
# =============================================================================
# Uncomment and modify these for local development

# NODE_ENV=development
# CI=false
# VITEST=false

# =============================================================================
# BUILD AND CI/CD CONFIGURATION
# =============================================================================
# These are typically set by the CI/CD environment

# Git commit SHA (set by GitHub Actions)
# GITHUB_SHA=commit_sha_here

# Git branch name (set by GitHub Actions)
# GITHUB_REF_NAME=branch_name_here

# Node.js authentication token for NPM publishing (set by GitHub Actions)
# NODE_AUTH_TOKEN=npm_token_here